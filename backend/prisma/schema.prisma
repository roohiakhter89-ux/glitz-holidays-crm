// Glitz Holidays CRM — Prisma schema
// Phase 1: User + Role.  Phase 3: Lead + Activity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Every Role is an internal staff account. External parties (hotels /
/// transport / B2B agents / prospective clients) are DATA — Vendor, Partner,
/// Lead — never logins. Do not add VENDOR, AGENT or GUEST back here; the
/// supplier-protection story falls apart the moment any outsider gets a
/// session token.
enum Role {
  SUPER_ADMIN
  OWNER
  SALES_MANAGER
  SALES_EXEC
  ACCOUNTS
  MARKETING
  OPERATIONS
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  QUOTATION_SENT
  NEGOTIATION
  CONFIRMED
  CANCELLED
  LOST
  FUTURE_FOLLOWUP
}

// ============================================================================
// PHASE 18 — Itinerary builder
// ============================================================================
//
// A quotation shows the PRICE the client will pay. An itinerary shows the
// day-by-day PLAN — pickup at the airport, hotel for two nights, shikara
// ride, gondola in Gulmarg. They're two separate artefacts that get sent
// together. The itinerary lives on the Lead (same as quotations) so both
// can be produced before the lead is confirmed as a booking.

enum ItineraryItemKind {
  STAY         // hotel / houseboat night
  TRANSFER     // pickup, drop, inter-city drive
  SIGHTSEEING  // gardens, monuments, viewpoints
  MEAL         // breakfast, lunch, dinner
  ACTIVITY     // shikara, skiing, trekking
  FREE_TIME
  NOTE
}

model Itinerary {
  id   String @id @default(cuid())
  /// Sequential per year — GLZ-ITI-2026-0001. Same convention as quotes and
  /// bookings; race-safe via withNumberRetry.
  code String @unique

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("ItineraryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // --- client-facing cover ---
  title    String
  headline String?
  intro    String?
  totalPax Int     @default(2)

  // Optional inclusion / exclusion lists (free-form, one per line).
  inclusions String?
  exclusions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days    ItineraryDay[]
  options ItineraryOption[]

  @@index([leadId])
}

/// Price tiers for the same day-by-day plan (e.g. Budget / Standard / Deluxe).
/// The days + items structure is shared; each option carries its own hotel /
/// transport picks via ItineraryItemPricing rows. Every itinerary always
/// has at least one option — the service auto-creates a "Package" on new
/// itineraries so simple single-price flows still work.
model ItineraryOption {
  id          String @id @default(cuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  name          String
  sortOrder     Int     @default(0)
  isRecommended Boolean @default(false)

  /// Option-level markup override. Null = fall back to service-type default.
  markupPercent Float?

  // --- computed, denormalised on every pricing write ---
  totalNet      Int   @default(0)
  totalSell     Int   @default(0)
  totalMargin   Int   @default(0)
  /// profit / sell * 100
  marginPercent Float @default(0)
  /// profit / cost * 100
  markupPercentEffective Float @default(0)
  perPersonSell Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricing ItineraryItemPricing[]

  @@index([itineraryId])
}

model ItineraryDay {
  id           String @id @default(cuid())
  itineraryId  String
  itinerary    Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  /// 1-based, unique per itinerary. Reordering days re-numbers this — see
  /// ItinerariesService.reorderDays.
  dayNumber Int
  /// Optional — leave blank for a flexible plan.
  date      DateTime?
  city      String?
  headline  String?
  summary   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ItineraryItem[]

  @@unique([itineraryId, dayNumber])
  @@index([itineraryId])
}

model ItineraryItem {
  id    String       @id @default(cuid())
  dayId String
  day   ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  kind        ItineraryItemKind @default(SIGHTSEEING)
  /// Free-form time hint — "09:00", "Afternoon", "Evening" — kept as text
  /// because tour operators use both clock times and named parts of day.
  time        String?
  title       String
  description String?
  location    String?

  /// Optional vendor link — used to auto-fill title/description from a
  /// stored hotel or transport vendor. Distinct from per-option vendorRateId
  /// on ItineraryItemPricing: this one is the "structural" hotel choice, used
  /// for text; pricing rows carry the actual RATE the tier is priced at.
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  /// Structural quantity + units — SHARED across price tiers because they
  /// describe the plan (2 rooms × 3 nights), not the money. Only the unit
  /// rate differs between Budget and Deluxe.
  quantity Int @default(1)
  units    Int @default(1)

  /// True when this item contributes to the option totals. Defaults per
  /// kind: STAY / TRANSFER / ACTIVITY / MEAL default true; SIGHTSEEING /
  /// FREE_TIME / NOTE default false. Operator can override.
  priceable Boolean @default(false)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricing ItineraryItemPricing[]

  @@index([dayId, sortOrder])
}

/// Per-item, per-option price cell. A row is written when an operator picks
/// a rate (or types a manual price) for a specific priceable item under a
/// specific tier. Absence = "not priced yet under this tier" (contributes 0
/// to the tier's totals but flagged in the UI).
model ItineraryItemPricing {
  id String @id @default(cuid())

  itemId String
  item   ItineraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  optionId String
  option   ItineraryOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  /// Optional pointer to the stored VendorRate this came from. Convenient
  /// for auditing ("which rate contract was this priced under?") — the
  /// numbers are frozen either way.
  vendorRateId String?
  /// Optional vendor for display when the rate wasn't picked from stored
  /// rates (e.g. one-off transport quote).
  vendorId String?

  /// REQUIRED. Net cost per unit per quantity (whole rupees).
  unitNet Int
  /// Line-level markup override. Null = use option / global default.
  markupPercent Float?

  // --- computed ---
  lineNet  Int @default(0)
  lineSell Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, optionId])
  @@index([optionId])
}

// ============================================================================
// PHASE 11 — HR module
// ============================================================================
//
// The Employee is a person on payroll — separate from User (login account),
// because not every employee has CRM access and not every login is on payroll.
// Optional userId links the two when they overlap. Salary slips and interview
// records live off Employee so history is retained if the person leaves.

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  NOTICE
  EXITED
}

enum InterviewOutcome {
  PENDING
  SELECTED
  ON_HOLD
  REJECTED
}

model Employee {
  id String @id @default(cuid())

  /// Human-friendly code, e.g. GLZ-EMP-0001. Sequential per year — same
  /// pattern as quoteNumber / bookingNumber so ops recognise it on sight.
  code String @unique

  // --- identity ---
  fullName    String
  fatherName  String?
  photoUrl    String?
  bloodGroup  String?
  dob         DateTime?
  gender      String?
  nationality String? @default("Indian")

  // --- contact ---
  phone       String
  altPhone    String?
  email       String?
  addressLine String?
  city        String?
  state       String?
  pincode     String?

  // --- emergency ---
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // --- ID + tax ---
  aadhaar String?
  pan     String?

  // --- employment ---
  designation      String
  department       String?
  employmentType   EmploymentType   @default(FULL_TIME)
  status           EmploymentStatus @default(ACTIVE)
  joinedOn         DateTime
  confirmedOn      DateTime?
  exitedOn         DateTime?
  reportsToId      String?
  reportsTo        Employee?        @relation("EmployeeReportsTo", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports          Employee[]       @relation("EmployeeReportsTo")

  /// Optional link to the login account. Set when the employee also has CRM
  /// access. Nullable because most HR records outlive their login (or never
  /// need one — e.g. driver, admin support).
  userId String? @unique
  user   User?   @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)

  // --- pay structure (monthly, in paise-consistent integer INR) ---
  ctcMonthly    Int?
  basicMonthly  Int?
  hraMonthly    Int?
  allowMonthly  Int?
  pfMonthly     Int?
  esiMonthly    Int?
  taxMonthly    Int?
  otherDedMonthly Int?
  bankName      String?
  accountNumber String?
  ifsc          String?

  // --- free-form ---
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salarySlips    SalarySlip[]
  interviews     Interview[]  @relation("InterviewInterviewer")

  @@index([status])
  @@index([department])
  @@index([reportsToId])
}

/// A salary slip is a FROZEN snapshot for a month. We store the components
/// even though they're on Employee today, because HR raises will change the
/// Employee row and slips from prior months must not shift.
model SalarySlip {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// The month this slip is for. First day of month at 00:00 UTC.
  periodMonth DateTime

  daysWorked Int?
  daysInMonth Int?
  lop        Int?  // loss of pay days

  // ---- earnings (all in whole rupees) ----
  basic       Int @default(0)
  hra         Int @default(0)
  allowances  Int @default(0)
  bonus       Int @default(0)
  arrears     Int @default(0)

  // ---- deductions ----
  pf         Int @default(0)
  esi        Int @default(0)
  tax        Int @default(0)
  otherDed   Int @default(0)

  // ---- computed and stored so historic slips never drift ----
  grossPay Int @default(0)
  totalDed Int @default(0)
  netPay   Int @default(0)

  paidOn    DateTime?
  reference String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, periodMonth])
  @@index([periodMonth])
}

model Interview {
  id String @id @default(cuid())

  // --- candidate ---
  candidateName   String
  candidatePhone  String
  candidateEmail  String?
  role            String
  scheduledAt     DateTime
  durationMinutes Int?    @default(45)

  // --- interviewer (optional link to Employee) ---
  interviewerId   String?
  interviewer     Employee? @relation("InterviewInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)
  interviewerName String?

  // --- structured feedback ---
  /// Array of { question, answer, rating }. Kept as JSON so the sheet template
  /// can evolve without a schema migration on every tweak.
  questionnaire Json? @default("[]")

  overallRating Int?  // 1..5
  strengths     String?
  concerns      String?
  outcome       InterviewOutcome @default(PENDING)
  outcomeNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outcome])
  @@index([scheduledAt])
}

// ============================================================================
// PHASE 12 — SEO
// ============================================================================

model SeoSite {
  id String @id @default(cuid())

  /// Human name — "Glitz main site", "Kashmir landing pages".
  name String
  /// Homepage URL — the crawler starts here.
  url  String @unique

  /// Paths to include in every audit (relative or absolute). e.g. ["/",
  /// "/kashmir", "/ladakh"]. Empty array = just the homepage.
  crawlPaths String[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audits SeoAudit[]

  @@index([isActive])
}

/// An audit is a single point-in-time crawl of one page. Multiple pages under
/// one SeoSite produce multiple audit rows sharing a runId so the UI can
/// group them into a single "audit run".
model SeoAudit {
  id String @id @default(cuid())

  siteId String
  site   SeoSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /// Shared across every page audited in the same trigger.
  runId String
  /// The exact URL audited.
  url   String

  /// 0-100 composite. Weighted average of checks + PageSpeed scores.
  score Int @default(0)

  /// PageSpeed Insights scores (0-100). Nullable when the API was skipped
  /// or returned an error.
  perfScore   Int?
  a11yScore   Int?
  bpScore     Int?
  seoScore    Int?

  /// Core Web Vitals (LCP ms, CLS x1000, INP ms).
  lcpMs  Int?
  clsX1k Int?
  inpMs  Int?

  /// Full structured check list — pass/fail per rule. Stored as JSON so the
  /// rule set can evolve without schema churn.
  /// Shape: { passed: [...], failed: [...], warnings: [...] }
  checks Json?

  /// Actionable task list generated from failed checks. UI shows this as the
  /// "do today" queue.
  tasks Json?

  /// Non-empty when the crawl or PageSpeed call raised.
  errors String?

  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
  @@index([runId])
}

enum AdChannel {
  GOOGLE_ADS
  META_ADS
  INSTAGRAM
  YOUTUBE
  LINKEDIN
  SEO
  EMAIL
  AFFILIATE
  OTHER
}

enum LeadSource {
  GOOGLE_ADS
  META_ADS
  INSTAGRAM
  FACEBOOK
  LANDING_PAGE
  WEBSITE
  ORGANIC
  REFERRAL
  WALK_IN
  PHONE
  WHATSAPP
  TRADE_FAIR
  EMAIL
  B2B_AGENT
  OTHER
}

enum ActivityType {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
  STATUS_CHANGE
  ASSIGNMENT
  RE_ENQUIRY
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(SALES_EXEC)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedLeads Lead[]     @relation("LeadAssignee")
  createdBookings Booking[]        @relation("BookingCreator")
  createdItineraries Itinerary[]   @relation("ItineraryCreator")
  recordedPayments BookingPayment[] @relation("PaymentRecorder")
  activities    Activity[]

  /// Set when this login corresponds to a person on payroll.
  employee      Employee? @relation("EmployeeUser")

  @@index([role])
}

model Lead {
  id     String @id @default(cuid())

  // --- who ---
  name    String
  phone   String
  email   String?
  city    String?
  country String?

  // --- what they want ---
  destination String?
  travelDate  DateTime?
  nights      Int?
  adults      Int?
  children    Int?
  budget      Int?
  message     String?

  // --- pipeline ---
  status     LeadStatus @default(NEW)
  source     LeadSource @default(OTHER)
  score      Int        @default(0)
  scoreNotes String?
  lostReason String?

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  // --- attribution (this is what makes ROAS possible later) ---
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  gclid       String?
  fbclid      String?
  landingPage String?
  referrer    String?
  keyword     String?

  // --- context ---
  device    String?
  userAgent String?
  ipAddress String?

  enquiryCount Int       @default(1)
  lastContact  DateTime?
  nextFollowUp DateTime?

  /// Optional link to the Visit that produced this lead. Set only when the
  /// landing page beacon has fired and the form carried the returned visitId.
  /// Kept nullable because manual adds and re-enquiries do not have a visit.
  visitId String?
  visit   Visit?  @relation(fields: [visitId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]
  bookings   Booking[]
  itineraries Itinerary[]

  @@index([status])
  @@index([source])
  @@index([phone])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([visitId])
}

// ============================================================================
// PHASE 10 — Attribution: landing pages, visits, ad spend
// ============================================================================
//
// The point of this module is one number: cost per lead by campaign, by page,
// by day. Storing a single daily total across all channels — the tempting
// shortcut — makes it impossible to tell which ad is losing you money, which
// is the reason to measure spend in the first place.
//
// The chain is:  AdSpend(channel, campaign, page, day)
//                     -> Visit(landingPage, utms, gclid/fbclid)
//                     -> Lead(visitId)
//                     -> Quote -> Booking (revenue).
// Everything above Lead is data you own; nothing here calls Google or Meta.
// Offline conversion upload back to Google Ads is a later job that reads
// Lead.gclid and Booking.totalSell.

model LandingPage {
  id   String @id @default(cuid())
  /// URL slug, e.g. "kashmir-honeymoon-2026". Not the full URL — the page can
  /// live under multiple hostnames (staging, prod, apex, www) and still be
  /// the same funnel.
  slug String @unique
  name String
  /// Optional canonical URL for display on the dashboard.
  url  String?

  /// Free-form label — "honeymoon", "family", "adventure". Used to roll the
  /// dashboard up by intent rather than exact page.
  campaign String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits Visit[]
  spend  AdSpend[]

  @@index([isActive])
}

model Visit {
  id String @id @default(cuid())

  /// The visitor's first-party cookie (set by the landing page snippet).
  /// A returning visitor keeps the same visitorId but produces a new Visit
  /// row per session so time-to-lead stays measurable.
  visitorId String
  /// One row per SESSION per PAGE. If the same visitor lands on the same
  /// page again more than 30 minutes later, that is a new visit.
  sessionId String

  landingPageId String?
  landingPage   LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: SetNull)
  /// Path or slug the beacon reported. Kept even when landingPageId is null
  /// so unregistered pages still show up in the dashboard.
  pagePath String

  // --- attribution copied straight off the URL ---
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  gclid       String?
  fbclid      String?
  referrer    String?
  keyword     String?

  // --- context ---
  device    String?
  userAgent String?
  ipAddress String?
  country   String?

  createdAt DateTime @default(now())

  leads Lead[]

  @@index([visitorId])
  @@index([sessionId])
  @@index([landingPageId, createdAt])
  @@index([createdAt])
}

/// Daily spend broken down as far as the source data allows. One row per
/// (date, channel, campaign, page) — DO NOT collapse to one row per day.
/// Without the split, cost-per-lead is a company-wide average and cannot
/// answer "which ad should I kill".
model AdSpend {
  id String @id @default(cuid())

  /// Midnight UTC of the spend day. Aggregations key on this.
  spendDate DateTime
  channel   AdChannel @default(GOOGLE_ADS)

  /// The ad-platform's campaign name/id, exactly as reported.
  campaign String?
  /// Optional ad-group / ad-set breakdown.
  adGroup  String?

  landingPageId String?
  landingPage   LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: SetNull)

  /// Amount in the smallest currency unit (paise for INR) to match the rest
  /// of the schema. 12345 = ₹123.45.
  amount   Int
  currency String @default("INR")

  /// Optional volumetric detail from the ad platform for CPC/CTR later.
  impressions Int?
  clicks      Int?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spendDate, channel, campaign, landingPageId], map: "AdSpend_natural_key")
  @@index([spendDate])
  @@index([channel])
  @@index([landingPageId])
}

model Activity {
  id      String       @id @default(cuid())
  type    ActivityType @default(NOTE)
  content String

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
}

// ============================================================================
// PHASE 4 — Vendors
// ============================================================================

enum VendorType {
  HOTEL
  HOUSEBOAT
  TRANSPORT
  GUIDE
  ACTIVITY
  RESTAURANT
  PHOTOGRAPHER
  EVENT
  OTHER
}

enum Season {
  PEAK
  SHOULDER
  OFF
  FESTIVE
}

enum MealPlan {
  EP
  CP
  MAP
  AP
}

enum RateBasis {
  PER_ROOM_NIGHT
  PER_PERSON
  PER_PERSON_NIGHT
  PER_VEHICLE_DAY
  PER_TRANSFER
  PER_UNIT
}

model Vendor {
  id   String     @id @default(cuid())
  name String
  type VendorType @default(HOTEL)

  // where
  city    String?
  area    String?
  address String?

  // internal grading — your own quality call, not the star rating
  starRating    Int?
  falconGrade   String?

  // --- SENSITIVE: redacted for sales execs (supplier protection) ---
  contactPerson String?
  phone         String?
  altPhone      String?
  email         String?
  bankName      String?
  accountNumber String?
  ifsc          String?

  // commercial
  gstin        String?
  panNumber    String?
  paymentTerms String?

  // transport only — Kashmir union taxi zone constraints
  unionZone String?

  // --- hotel / property specifics -----------------------------------------
  // All optional. Filled in for HOTEL/HOUSEBOAT/RESORT; ignored for TRANSPORT etc.
  /// "14:00" — kept as a HH:MM string so timezone confusion can't creep in.
  checkInTime  String?
  /// "11:00" — checkout is the number ops needs on the client voucher.
  checkOutTime String?
  /// Total rooms in inventory. Not a live count — used to size availability
  /// gut-check, not for booking allocation.
  roomCount    Int?
  /// Free-form tags. Deliberately not an enum — hotel amenity lingo shifts
  /// too fast (spa, e-vehicle charging, halal kitchen, etc.).
  amenities    String[]

  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates VendorRate[]
  itineraryItems ItineraryItem[]

  @@index([type])
  @@index([city])
  @@index([isActive])
}

model VendorRate {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// Room category for hotels ("Deluxe"), vehicle type for transport ("Innova").
  variant   String
  season    Season    @default(PEAK)
  mealPlan  MealPlan?
  rateBasis RateBasis @default(PER_ROOM_NIGHT)

  /// REQUIRED. What you actually pay the supplier.
  netRate Int
  /// Optional. Published/rack rate for showing discount.
  rackRate Int?

  extraBedRate  Int?
  childRate     Int?
  maxOccupancy  Int?

  validFrom DateTime?
  validTo   DateTime?

  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The natural key of a rate line in a contract. Stops the same rate being
  /// entered twice with different prices, where whichever sorted first would
  /// silently win the quote.
  /// CAVEAT: Postgres treats NULLs as distinct in a unique index, so this only
  /// bites once mealPlan / rateBasis / validFrom are actually filled in.
  /// Always set validFrom — a rate contract without a start date is a guess.
  @@unique([vendorId, variant, season, mealPlan, rateBasis, validFrom], map: "VendorRate_natural_key")
  @@index([vendorId])
  @@index([season])
  @@index([isActive])
  @@index([validFrom, validTo])
}

// ============================================================================
// PHASE 5 — Pricing + Quotations
// ============================================================================

enum ServiceType {
  HOTEL
  TRANSPORT
  ACTIVITY
  FLIGHT
  GUIDE
  MEAL
  PERMIT
  MISC
}

enum MarkupMode {
  /// Use the option / service-type / global default (the normal case).
  INHERIT
  /// Percentage on this line's net cost.
  PERCENT
  /// Flat amount added on top of this line's net cost.
  FIXED
  /// Operator types the sell price directly; margin is derived.
  MANUAL
}


/// Singleton config row (id is always "default").
model PricingSettings {
  id String @id @default("default")

  /// Fallback markup % when nothing more specific is set.
  defaultMarkupPercent Float @default(20)

  /// Per-service-type overrides. Null = fall back to defaultMarkupPercent.
  hotelMarkupPercent     Float?
  transportMarkupPercent Float?
  activityMarkupPercent  Float?
  flightMarkupPercent    Float?
  guideMarkupPercent     Float?
  mealMarkupPercent      Float?
  permitMarkupPercent    Float?
  miscMarkupPercent      Float?

  /// Policy: minimum acceptable MARGIN % (profit / sell price).
  minMarginPercent Float @default(15)

  /// Break-even inputs. Without these the advisory can only check margin %.
  monthlyOverhead Int?
  filesPerMonth   Int?

  gstPercent Float @default(5)
  /// Round sell prices to the nearest N rupees (0 = no rounding).
  roundTo    Int   @default(10)

  currency  String   @default("INR")
  updatedAt DateTime @updatedAt
}


// ============================================================================
// PHASE 6 — Bookings + Payments
// ============================================================================

enum BookingStatus {
  PENDING
  CONFIRMED
  PARTIALLY_PAID
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  RAZORPAY
  OTHER
}

model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  status        BookingStatus @default(PENDING)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Where it came from. Frozen snapshot — the totals below do NOT follow
  /// later edits to the itinerary tier. Nullable so a manual lead-only
  /// booking (no plan behind it) can still exist.
  itineraryId        String?
  itineraryOptionId  String?

  createdById String?
  createdBy   User?   @relation("BookingCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // --- trip ---
  packageName     String?
  travelStartDate DateTime?
  travelEndDate   DateTime?
  adults          Int       @default(2)
  children        Int       @default(0)
  nights          Int       @default(0)

  // --- FROZEN pricing snapshot (taken at confirmation) ---
  totalSell Int @default(0)
  /// Estimated cost from the quote at the time of booking.
  totalNet  Int @default(0)

  // --- running actuals ---
  totalReceived Int @default(0)
  totalCostPaid Int @default(0)

  notes      String?
  cancelledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments BookingPayment[]
  costs    BookingCost[]

  @@index([leadId])
  @@index([status])
  @@index([travelStartDate])
}

/// Money IN from the client. Negative amounts represent refunds.
model BookingPayment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount     Int
  mode       PaymentMode @default(BANK_TRANSFER)
  reference  String?
  receivedAt DateTime    @default(now())
  notes      String?
  isRefund   Boolean     @default(false)

  recordedById String?
  recordedBy   User?   @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([receivedAt])
}

/// Money OUT to vendors — what is owed vs what has actually been paid.
model BookingCost {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  vendorId    String?
  description String

  amountDue  Int
  amountPaid Int       @default(0)
  paidAt     DateTime?
  reference  String?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([vendorId])
}
