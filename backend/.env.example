# ---- Database (use your Supabase connection string) -------------------------
# Supabase -> Project Settings -> Database -> Connection string (URI).
# Use the pooled connection (port 6543) for the app, and add ?pgbouncer=true.
# For migrations, use the direct connection (port 5432).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# ---- App --------------------------------------------------------------------
PORT=3000
CORS_ORIGIN="*"

# ---- Auth (used from Phase 2 onward) ---------------------------------------
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ---- Seed owner account -----------------------------------------------------
SEED_ADMIN_EMAIL="admin@glitz.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Glitz Owner"
