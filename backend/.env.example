# ---- Database (use your Supabase connection string) -------------------------
# Supabase -> Project Settings -> Database -> Connection string (URI).
#
# BOTH are required — prisma/schema.prisma declares `directUrl`, and Prisma
# refuses to start if the variable is missing. Leaving DIRECT_URL unset makes
# `prisma migrate deploy` fail on boot.
#
# DATABASE_URL  pooled connection (port 6543), used by the running app.
# DIRECT_URL    direct connection (port 5432), used by migrations only —
#               migrations cannot run through pgbouncer.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---- App --------------------------------------------------------------------
PORT=3000
CORS_ORIGIN="*"

# ---- Auth (used from Phase 2 onward) ---------------------------------------
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ---- Seed owner account -----------------------------------------------------
SEED_ADMIN_EMAIL="admin@glitz.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Glitz Owner"
