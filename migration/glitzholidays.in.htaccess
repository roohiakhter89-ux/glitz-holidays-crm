# =============================================================================
# 301 MIGRATION MAP  —  glitzholidays.in  ➜  glitz-holidays.in
# =============================================================================
# Upload this file as `.htaccess` in the DOCUMENT ROOT of the OLD site
# (glitzholidays.in, the PHP site). It sends every legacy URL to its closest
# equivalent on the new Next.js site, preserving as much ranking signal as a
# 301 can carry.
#
# BEFORE YOU UPLOAD — in this order:
#   1. Confirm glitz-holidays.in is fully live and every target URL below
#      returns 200. A 301 into a 404 destroys the signal instead of moving it.
#   2. In Google Search Console, add glitz-holidays.in as a property and
#      verify it. Then use "Change of Address" on the glitzholidays.in
#      property — this is what actually tells Google the move is deliberate.
#      The redirects alone are not enough.
#   3. Update the WEBSITE field on the Google Business Profile to
#      https://glitz-holidays.in — otherwise the Knowledge Panel keeps
#      pointing at the old domain and your 604 reviews stay associated
#      with it.
#   4. Update the link in the Instagram bio (@glitzholidays9).
#
# AFTER UPLOADING:
#   - Keep this file in place for AT LEAST 12 months. Google needs repeated
#     crawls to fully transfer authority; removing it early strands the
#     equity mid-transfer.
#   - Do NOT let the old domain expire while these redirects matter.
#
# Query-string URLs need mod_rewrite (plain `Redirect 301` cannot read a
# query string), which is why the rules below use RewriteCond/RewriteRule.
# The trailing `?` on each target strips the original query string so it is
# not appended to the clean new URL.
# =============================================================================

RewriteEngine On

# --- Canonical host: send www to the apex before anything else --------------
RewriteCond %{HTTP_HOST} ^www\.glitzholidays\.in$ [NC]
RewriteRule ^(.*)$ https://glitz-holidays.in/$1 [R=301,L]

# --- Static pages -----------------------------------------------------------
RewriteRule ^index\.php$    https://glitz-holidays.in/ [R=301,L]
RewriteRule ^about\.php$    https://glitz-holidays.in/about [R=301,L]
RewriteRule ^contact\.php$  https://glitz-holidays.in/contact [R=301,L]
RewriteRule ^packages\.php$ https://glitz-holidays.in/packages [R=301,L]
RewriteRule ^privacy\.php$  https://glitz-holidays.in/privacy-policy [R=301,L]
RewriteRule ^terms\.php$    https://glitz-holidays.in/terms-and-conditions [R=301,L]

# activities.php has no exact counterpart; the adventure travel-style page is
# the closest intent match.
RewriteRule ^activities\.php$ https://glitz-holidays.in/travel-styles/adventure [R=301,L]

# --- Region hubs  (region.php?r=…) -----------------------------------------
RewriteCond %{QUERY_STRING} (^|&)r=kashmir(&|$)
RewriteRule ^region\.php$ https://glitz-holidays.in/destinations/kashmir? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)r=leh-ladakh(&|$)
RewriteRule ^region\.php$ https://glitz-holidays.in/destinations/ladakh? [R=301,L]

# The old "Jammu" region was Katra + Patnitop — i.e. the Vaishno Devi circuit.
RewriteCond %{QUERY_STRING} (^|&)r=jammu(&|$)
RewriteRule ^region\.php$ https://glitz-holidays.in/destinations/vaishno-devi? [R=301,L]

# Any other region value falls back to the destinations index.
RewriteRule ^region\.php$ https://glitz-holidays.in/destinations? [R=301,L]

# --- Destinations  (destination.php?slug=…) ---------------------------------
# The old site had 29 thin destination pages. The new site consolidates them
# into 4 substantial hubs, so these are many-to-one by design — consolidating
# thin pages into one strong page is the intended outcome, not a loss.

# Kashmir valley
RewriteCond %{QUERY_STRING} (^|&)slug=(srinagar|gulmarg|pahalgam|sonamarg|doodhpathri|yusmarg|gurez|lolab-valley|naranag|daksum|sinthan-top|aharbal|watlab|warwan-valley|peer-ki-gali)(&|$)
RewriteRule ^destination\.php$ https://glitz-holidays.in/destinations/kashmir? [R=301,L]

# Ladakh
RewriteCond %{QUERY_STRING} (^|&)slug=(pangong-lake|nubra-valley|tso-moriri-lake|tso-kar-lake|zanskar-valley|suru-valley|kargil|lamayuru|alchi|dha-hanu|magnetic-hill|keylong)(&|$)
RewriteRule ^destination\.php$ https://glitz-holidays.in/destinations/ladakh? [R=301,L]

# Jammu / Vaishno Devi circuit
RewriteCond %{QUERY_STRING} (^|&)slug=(katra|patnitop)(&|$)
RewriteRule ^destination\.php$ https://glitz-holidays.in/destinations/vaishno-devi? [R=301,L]

# Unknown destination slug → destinations index rather than a 404.
RewriteRule ^destination\.php$ https://glitz-holidays.in/destinations? [R=301,L]

# --- Packages  (package-detail.php?slug=…) ----------------------------------
# Mapped to the nearest equivalent by nights + region, not by name.
RewriteCond %{QUERY_STRING} (^|&)slug=breathtaking-5n-6d(&|$)
RewriteRule ^package-detail\.php$ https://glitz-holidays.in/packages/kashmir-honeymoon-5-nights? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)slug=marvellous-6n-7d(&|$)
RewriteRule ^package-detail\.php$ https://glitz-holidays.in/packages/complete-kashmir-6-nights? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)slug=nature-beauty-5n-6d(&|$)
RewriteRule ^package-detail\.php$ https://glitz-holidays.in/packages/classic-kashmir-4-nights? [R=301,L]

# Any other package slug → the packages index.
RewriteRule ^package-detail\.php$ https://glitz-holidays.in/packages? [R=301,L]

# --- Catch-all --------------------------------------------------------------
# Anything not matched above goes to the new home page. Keep this LAST.
# Excludes robots.txt so crawlers can still read it during the transition,
# and excludes the Google/Bing verification files.
RewriteCond %{REQUEST_URI} !^/robots\.txt$
RewriteCond %{REQUEST_URI} !^/google[0-9a-f]+\.html$
RewriteCond %{REQUEST_URI} !^/BingSiteAuth\.xml$
RewriteRule ^(.*)$ https://glitz-holidays.in/ [R=301,L]
